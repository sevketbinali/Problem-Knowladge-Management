# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL async connection string
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/pkms

# ─── Vector Store ─────────────────────────────────────────────────────────────
# Qdrant HTTP endpoint
# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL async connection string
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/pkms

# ─── Vector Store ─────────────────────────────────────────────────────────────
# Qdrant HTTP endpoint
QDRANT_URL=http://localhost:6333

# ─── Cache / Queue ────────────────────────────────────────────────────────────
# Redis connection string (used for caching and Celery broker)
REDIS_URL=redis://localhost:6379/0

# ─── External APIs ────────────────────────────────────────────────────────────
# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Security ─────────────────────────────────────────────────────────────────
# Secret key for JWT signing — use a long random string in production
JWT_SECRET=replace-with-a-long-random-secret-string
